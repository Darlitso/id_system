# Copy to .env (never commit .env). Placeholders only.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase: use the POOLER string from Project Settings -> Database (session mode, port 5432).
# Do NOT append sslmode=... here; TLS is configured in src/config/db.js.
DATABASE_URL=postgresql://identity_api.<project-ref>:<password>@<pooler-host>:5432/postgres
# Optional: path to the Supabase root CA (download from Project Settings -> Database)
# DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
# Local Postgres only (no TLS): DATABASE_SSL=disable

# Biometric template encryption (DEV keyring only; use external key management in production).
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BIOMETRIC_ACTIVE_KEY_ID=dev-k1
BIOMETRIC_KEYS={"dev-k1":"<base64-32-byte-key>"}

# Dedup thresholds (0-100 score). Placeholders; tune on real data. Matches are never auto-confirmed.
DEDUP_REVIEW_SCORE=40
